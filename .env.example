# עותק את הקובץ הזה ל-.env ומלאי את הערכים החסרים (ראו הערות).
# הקובץ הזה נשמר ב-git כתיעוד בלבד — לא מכיל סודות אמיתיים.

DATABASE_URL="file:./dev.db"

# אחסון קבצים (סעיף 9) — "local" עד לחיבור Google Drive בפועל (סעיף 9.1)
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage

# חיבור ל-Meta Graph API (אינסטגרם/פייסבוק) — מ-App Dashboard > Settings > Basic
# App ID מופיע גם ליד "App ID" בדשבורד; App Secret מוצג בלחיצה על "Show" (דורש סיסמה)
META_APP_ID=
META_APP_SECRET=

# חיבור ל-Notion API — "Internal Integration Secret" מ-notion.so/my-integrations
# (אחרי ששיתפת את הטבלה שלך עם האינטגרציה, ראו הגדרות > Notion בכלי)
NOTION_API_KEY=
