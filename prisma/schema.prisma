// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// אחד לכל פוסט מקורי שנכתב על ידי המשתמשת
model Post {
  id              String   @id @default(cuid())
  slug            String   @unique
  rawText         String
  selectedTargets String // JSON string array, e.g. ["facebook","instagram_carousel","instagram_story"]
  // תגיות משותפות לכל התוכן של הפוסט (קרוסלה + סטורי) — מקור אחד, לא כפילות
  // לכל יעד בנפרד. בלי התגית הקבועה #אחתביום, שמתווספת אוטומטית בזמן רינדור.
  hashtags        String   @default("[]")
  // אופן החילוק שנבחר ביצירה ("auto"/"manual") — נשמר במפורש כדי שרינדורים
  // חדשים (עדכון טקסט, הוספת יעד) ימשיכו להתייחס אליו כמו שהמשתמשת בחרה,
  // ולא ינחשו אותו מנוכחות סימוני /// בטקסט (שעכשיו יכולים להופיע גם במצב אוטומטי).
  splitMode       String   @default("auto")
  // אנימציית החשיפה בריל: "word" (מילה-מילה) או "letter" (אות-אות) — נשמר
  // במפורש כמו splitMode, כדי שרינדורים חדשים לפוסט הזה ימשיכו להשתמש באותה
  // בחירה שנעשתה ביצירה.
  revealMode      String   @default("word")
  folderPath      String // נתיב תיקיית הפוסט באחסון (מקומי היום, Google Drive בעתיד)
  privacyFlags    String // JSON array of PrivacyFlag
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // תיוג AI (ניתוח טקסט הפוסט המקורי, לא תלוי בפרסום בפועל) — לשימוש בפילטור
  // בעמוד "הפוסטים שלי" ובהשוואות בדשבורד (רק לפוסטים שגם קושרו לאינסטגרם).
  aiTheme        String? // נושא/רגש מרכזי, למשל "פחד", "קנאה", "אהבה" — קטגוריה חופשית מתוך רשימת מועמדים
  aiFormat       String? // "letter" (מכתב/פנייה ישירה) או "regular"
  aiTone         String? // "realistic" או "absurd"
  aiClassifiedAt DateTime?

  platformContents PlatformContent[]
}

enum PlatformType {
  facebook_post
  instagram_carousel
  instagram_reel
  instagram_story
  whatsapp_link
}

enum ContentStatus {
  draft
  ready
  scheduled
  published
}

model PlatformContent {
  id         String       @id @default(cuid())
  postId     String
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  type       PlatformType
  folderPath String

  text            String? // טקסט מוצע/מוכן
  files           String // JSON array of file names relative to folderPath
  altText         String? // תמלול לתמונות, לפי סעיף 7
  hashtags        String // JSON array
  tags            String // JSON array
  suggestedSongs  String // JSON array of {title, artist}
  suggestedHighlight String? // לסטורי בלבד
  backgroundColor String? // hex — רקע הסטורי (סעיף 4.6); null = נבחר אוטומטית
  // איזו תבנית רקע שהועלתה בהגדרות (קרוסלה או ריל, לפי type) נבחרה לתוכן הזה
  // בזמן יצירת הפוסט — null = בלי תבנית (קרוסלה: רקע לבן; ריל: צבע אוטומטי).
  // נשמר במפורש כדי שרינדורים חדשים לתוכן הזה (עדכון טקסט/תגיות) ימשיכו
  // להשתמש באותה תבנית, ולא יחזרו לבררת המחדל.
  backgroundImagePath String?
  // תבנית רקע לעמוד שער (רק בקרוסלה) — אם קיים, נוסף עמוד ראשון נוסף (לא
  // נספר במספור "X/Y" של שאר העמודים) עם הרקע הזה והתיוג הראשי של הפוסט
  // מוצג עליו במרכז, גדול. null = בלי עמוד שער.
  coverImagePath String?

  // אורך הריל בשניות — מחושב אוטומטית ברינדור (לא הזנה ידנית), לצורך
  // השוואות באורך בדשבורד האנליטיקס (ראו /dashboard). null לקרוסלה.
  durationSeconds Float?

  // נתוני ביצועים בפועל — מוזנים ידנית (המשתמשת קוראת אותם ישירות מאינסטגרם/
  // פייסבוק), אין כרגע חיבור API ל-Meta. null = עדיין לא הוזן.
  likesCount             Int?
  commentsCount          Int?
  viewsCount             Int? // "plays"/reach לפי הפלטפורמה
  avgWatchSeconds        Float? // רק לריל — זמן צפייה ממוצע, כמו שמופיע בתובנות אינסטגרם
  followersReachPercent  Float? // אחוז מהצופים/מהגעה שהיו עוקבים כבר (0-100) — עדיין ידני, לא נשלף אוטומטית
  metricsUpdatedAt       DateTime?

  // קישור לפוסט המקביל באינסטגרם בפועל (נבחר ידנית מרשימת הפוסטים שלה) —
  // מאפשר סנכרון אוטומטי של likesCount/commentsCount/viewsCount/avgWatchSeconds
  // דרך Graph API, במקום הזנה ידנית.
  instagramMediaId   String?
  instagramPermalink String?

  publishedAt   DateTime?
  status        ContentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// עותק מקומי (cache) של פוסטים אמיתיים מאינסטגרם, נשלף ישירות מ-Graph API —
// עצמאי לגמרי מ-Post/PlatformContent. משמש כמקור הנתונים היחיד לדשבורד
// האנליטיקס (/dashboard), כדי שהדשבורד ישקף את כל הנוכחות שלה באינסטגרם ולא
// רק פוסטים שנוצרו בכלי הזה.
model InstagramMedia {
  id                String   @id // ה-ID האמיתי של הפוסט באינסטגרם
  caption           String?
  timestamp         DateTime
  permalink         String
  mediaType         String // IMAGE / VIDEO / CAROUSEL_ALBUM
  mediaProductType  String?
  thumbnailUrl      String?
  // נגזרים מהכיתוב האמיתי באינסטגרם (לא מהטקסט בכלי) — לצורך ממדי השוואה
  // שמבוססים רק על מידע מהרשת.
  captionWordCount  Int
  hashtagCount      Int
  likesCount        Int?
  commentsCount     Int?
  viewsCount        Int? // "views" — סך הצפיות/הפעמים שהפוסט נפתח (יכול לכלול צפיות חוזרות)
  reachCount        Int? // "reach" — כמות חשבונות ייחודיים שנחשפו לפוסט
  // "saved"/"shares" — סימני חיבוב אלגוריתם חזקים משמעותית מלייקים (לפי
  // ההצהרות הפומביות של מטא על שיקולי דירוג) — מוצגים כברירת מחדל בהשוואות.
  savedCount        Int?
  sharesCount       Int?
  avgWatchSeconds   Float?
  // אורך הריל בשניות — Graph API לא חושף את זה, אז זה מגיע (אופציונלי, רק אם
  // קיים) מה-PlatformContent המקומי המקושר (אם הפוסט נוצר בכלי הזה). null
  // לפוסטים שלא נוצרו בכלי או שלא קושרו — לא נדרש לשום פונקציונליות אחרת.
  durationSeconds   Float?
  // תיוג AI — גם זה לא חשוף ב-API, מגיע (אופציונלי) מה-Post המקומי המקושר,
  // רק אם הפוסט גם נוצר בכלי וגם סווג. null אחרת — לא חובה לשום השוואה אחרת.
  aiTheme           String?
  aiFormat          String?
  aiTone            String?
  syncedAt          DateTime @updatedAt
}

// פרופיל תצוגה קבוע שמוצג בעמודי הקרוסלה/ריל
model ProfileSettings {
  id               String @id @default("default")
  displayName      String @default("")
  profileImagePath String? // נתיב לקובץ תמונת פרופיל באחסון המקומי
  // לינק מלא לפרופיל שלה בפייסבוק — פייסבוק הסירו את סוג ה-URL הישן שאפשר
  // חיפוש-בתוך-פרופיל בקישור ישיר, אז זה רק פותח את הפרופיל; החיפוש בתגית
  // עצמו נעשה ידנית משם (ראו posts/new/page.tsx).
  facebookProfileUrl String?
  // תבניות רקע שהועלו לבחירה (JSON array של נתיבי קבצים) — נבחרת אחת מהן,
  // או אף אחת, בזמן יצירת פוסט (ראו PlatformContent.backgroundImagePath).
  reelBackgroundImagePaths     String   @default("[]")
  carouselBackgroundImagePaths String   @default("[]")
  // תבניות רקע לעמוד השער (הראשון, עם התיוג הראשי במרכז) — ראו PlatformContent.coverImagePath.
  coverBackgroundImagePaths String   @default("[]")
  highlights                String   @default("[]") // JSON array of highlight names
  // רשימת נושאים לתיוג ידני של פוסטים (ראו InstagramMediaLabelEditor) —
  // ניתנת לעריכה בהגדרות (הוספה/הסרה), לא קבועה בקוד.
  aiThemeOptions String @default("[\"פחד\",\"קנאה\",\"אהבה\",\"כעס\",\"געגוע\",\"בדידות\",\"בושה\",\"אשמה\",\"שמחה\",\"תסכול\",\"נוסטלגיה\",\"ביקורת חברתית\",\"אחר\"]")

  // חיבור ל-Meta Graph API (אינסטגרם/פייסבוק) — לשליפת נתוני ביצועים אמיתיים
  // בלי הרשאה מיוחדת ממטא (Standard Access, חשבון עצמי בלבד). הטוקן ארוך-הטווח
  // (60 יום) נוצר ע"י המרה של טוקן קצר-טווח שמודבק מ-Graph API Explorer בהגדרות.
  metaAccessToken               String?
  metaTokenExpiresAt            DateTime?
  metaPageId                    String?
  metaPageName                  String?
  metaInstagramBusinessAccountId String?
  // מתי הופעל לאחרונה סנכרון הדשבורד בפועל (ראו syncInstagramMediaSince) —
  // שונה מה"טווח" שמסונכרן (התאריך העדכני ביותר בין הפוסטים עצמם).
  lastDashboardSyncAt DateTime?

  // תמונת מצב של דמוגרפיית העוקבים (גיל/מין/מדינה) — לא היסטוריה, רק המצב
  // העדכני בזמן הסנכרון האחרון. JSON arrays של {label, value}.
  audienceGenderJson  String?
  audienceAgeJson     String?
  audienceCountryJson String?
  // חשיפה למי שלא עוקב אחריה לעומת מי שכן — מצטבר על פני כל תקופת הסנכרון
  // (מדד ברמת החשבון בלבד, לא לכל פוסט בנפרד — כך חושפת מטא את הנתון הזה),
  // מופרד לריל לעומת פוסט/קרוסלה. JSON: {reel:{follower,nonFollower},post:{follower,nonFollower}}.
  audienceReachByFollowJson String?

  updatedAt                    DateTime @updatedAt
}
