// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// אחד לכל פוסט מקורי שנכתב על ידי המשתמשת
model Post {
  id              String   @id @default(cuid())
  slug            String   @unique
  rawText         String
  selectedTargets String // JSON string array, e.g. ["facebook","instagram_carousel","instagram_story"]
  // תגיות משותפות לכל התוכן של הפוסט (קרוסלה + סטורי) — מקור אחד, לא כפילות
  // לכל יעד בנפרד. בלי התגית הקבועה #אחתביום, שמתווספת אוטומטית בזמן רינדור.
  hashtags        String   @default("[]")
  // אופן החילוק שנבחר ביצירה ("auto"/"manual") — נשמר במפורש כדי שרינדורים
  // חדשים (עדכון טקסט, הוספת יעד) ימשיכו להתייחס אליו כמו שהמשתמשת בחרה,
  // ולא ינחשו אותו מנוכחות סימוני /// בטקסט (שעכשיו יכולים להופיע גם במצב אוטומטי).
  splitMode       String   @default("auto")
  // אנימציית החשיפה בריל: "word" (מילה-מילה) או "letter" (אות-אות) — נשמר
  // במפורש כמו splitMode, כדי שרינדורים חדשים לפוסט הזה ימשיכו להשתמש באותה
  // בחירה שנעשתה ביצירה.
  revealMode      String   @default("word")
  folderPath      String // נתיב תיקיית הפוסט באחסון (מקומי היום, Google Drive בעתיד)
  privacyFlags    String // JSON array of PrivacyFlag
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  platformContents PlatformContent[]
}

enum PlatformType {
  facebook_post
  instagram_carousel
  instagram_reel
  instagram_story
  whatsapp_link
}

enum ContentStatus {
  draft
  ready
  scheduled
  published
}

model PlatformContent {
  id         String       @id @default(cuid())
  postId     String
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  type       PlatformType
  folderPath String

  text            String? // טקסט מוצע/מוכן
  files           String // JSON array of file names relative to folderPath
  altText         String? // תמלול לתמונות, לפי סעיף 7
  hashtags        String // JSON array
  tags            String // JSON array
  suggestedSongs  String // JSON array of {title, artist}
  suggestedHighlight String? // לסטורי בלבד
  backgroundColor String? // hex — רקע הסטורי (סעיף 4.6); null = נבחר אוטומטית
  // איזו תבנית רקע שהועלתה בהגדרות (קרוסלה או ריל, לפי type) נבחרה לתוכן הזה
  // בזמן יצירת הפוסט — null = בלי תבנית (קרוסלה: רקע לבן; ריל: צבע אוטומטי).
  // נשמר במפורש כדי שרינדורים חדשים לתוכן הזה (עדכון טקסט/תגיות) ימשיכו
  // להשתמש באותה תבנית, ולא יחזרו לבררת המחדל.
  backgroundImagePath String?
  // תבנית רקע לעמוד שער (רק בקרוסלה) — אם קיים, נוסף עמוד ראשון נוסף (לא
  // נספר במספור "X/Y" של שאר העמודים) עם הרקע הזה והתיוג הראשי של הפוסט
  // מוצג עליו במרכז, גדול. null = בלי עמוד שער.
  coverImagePath String?

  publishedAt   DateTime?
  status        ContentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// פרופיל תצוגה קבוע שמוצג בעמודי הקרוסלה/ריל
model ProfileSettings {
  id               String @id @default("default")
  displayName      String @default("")
  profileImagePath String? // נתיב לקובץ תמונת פרופיל באחסון המקומי
  // תבניות רקע שהועלו לבחירה (JSON array של נתיבי קבצים) — נבחרת אחת מהן,
  // או אף אחת, בזמן יצירת פוסט (ראו PlatformContent.backgroundImagePath).
  reelBackgroundImagePaths     String   @default("[]")
  carouselBackgroundImagePaths String   @default("[]")
  // תבניות רקע לעמוד השער (הראשון, עם התיוג הראשי במרכז) — ראו PlatformContent.coverImagePath.
  coverBackgroundImagePaths String   @default("[]")
  highlights                String   @default("[]") // JSON array of highlight names
  updatedAt                    DateTime @updatedAt
}
