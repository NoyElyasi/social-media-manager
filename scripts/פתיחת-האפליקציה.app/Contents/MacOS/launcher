#!/bin/bash
# עוטפת את scripts/open-app.command כאפליקציית מאק אמיתית — כדי שאפשר לגרור
# אותה ל-Dock (בניגוד לקובץ .command רגיל, שה-Dock לא מקבל אותו כקיצור
# הפעלה תקין). כל הלוגיקה בפועל נשארת במקום אחד (open-app.command).
#
# חשוב: לא מריצים את הסקריפט ישירות (exec) — אפליקציה שנפתחת מ-Finder/Dock
# מקבלת מ-macOS סביבה חסרה (PATH בסיסי בלי Homebrew/nvm, כאילו npm לא קיים
# בכלל) ובלי חלון טרמינל נראה לעין, בניגוד להרצה מטרמינל רגיל (שמריץ קודם
# את קובץ ההגדרות של המעטפת, ../.zshrc/.zprofile, ששם ה-PATH המלא מוגדר).
# פתיחת הסקריפט בתוך Terminal.app בפועל (ולא הרצה שקטה) פותרת את שני
# הדברים בבת אחת: גם סביבת מעטפת מלאה, וגם חלון נראה לעין.
SCRIPT_PATH="$(cd "$(dirname "$0")/../../.." && pwd)/open-app.command"
osascript -e "tell application \"Terminal\" to do script \"bash '$SCRIPT_PATH'\""
