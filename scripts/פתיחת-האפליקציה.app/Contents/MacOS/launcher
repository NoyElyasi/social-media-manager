#!/bin/bash
# עוטפת את scripts/open-app.command כאפליקציית מאק אמיתית — כדי שאפשר לגרור
# אותה ל-Dock (בניגוד לקובץ .command רגיל, שה-Dock לא מקבל אותו כקיצור
# הפעלה תקין). כל הלוגיקה בפועל נשארת במקום אחד (open-app.command), כדי
# שלא יהיו שני מימושים שיכולים לסטות אחד מהשני.
exec "$(dirname "$0")/../../../open-app.command"
